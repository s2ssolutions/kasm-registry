{
    "friendly_name": "Brave",
    "image_src": "brave.png",
    "description": "The Brave browser is a fast, private and secure web browser.",
    "cores": 1,
    "memory": 1792,
    "gpu_count": 0,
    "cpu_allocation_method": "Inherit",
    "docker_registry": "https://index.docker.io/v1/",
    "categories": [
      "Browser"
    ],
    "require_gpu": false,
    "enabled": true,
    "image_type": "Container",
    "run_config": {
      "hostname": "kasm",
      "environment": {
        "SHOW_VPN_STATUS": 0,
        "SHOW_IP_STATUS": 0
      }
    },
    "exec_config": {
      "go": {
        "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
      },
      "assign": {
        "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
      }
    },
    "architecture": [
      "amd64"
    ],
    "compatibility": [
      {
        "version": "1.17.x",
        "image": "s2ssolutions/brave:test",
        "uncompressed_size_mb": 2955,
        "available_tags": [
          "develop",
            "test"
        ]
      }
    ]
  }