{
  "friendly_name": "Tor-Browser",
  "image_src": "tor-browser.png",
  "description": "Tor is free and open-source software for enabling anonymous communication by directing Internet traffic through a free, worldwide, volunteer overlay network.",
  "cores": 1,
  "memory": 1792,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "https://index.docker.io/v1/",
  "categories": [
    "Browser",
    "Privacy"
  ],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "run_config": {
    "hostname": "kasm",
    "environment": {
      "SHOW_VPN_STATUS": 0,
      "SHOW_IP_STATUS": 0
    }
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "s2ssolutions/tor-browser:test",
      "uncompressed_size_mb": 2862,
      "available_tags": [
        "develop",
        "test"
      ]
    }
  ]
}